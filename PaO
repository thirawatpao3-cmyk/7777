local function makeActionBtn(text, yPos, isPrimary)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = isPrimary and THEME.ACCENT or THEME.SURFACE
    btn.Text = text
    btn.TextColor3 = isPrimary and THEME.TEXT_DARK or THEME.TEXT_MAIN
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.Parent = rightPane
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = isPrimary and THEME.ACCENT_DARK or THEME.BORDER

    btn.MouseEnter:Connect(function()
        tween(btn, {BackgroundColor3 = isPrimary and THEME.ACCENT_DARK or THEME.SURFACE_HOVER})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, {BackgroundColor3 = isPrimary and THEME.ACCENT or THEME.SURFACE})
    end)
    return btn
end

