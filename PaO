local function refreshList()
    local query = searchBox.Text:lower()
    for p, btn in pairs(playerBtnItems) do
        if p and p.Parent then
            local match = p.Name:lower():find(query) or p.DisplayName:lower():find(query)
            btn.Visible = match ~= nil
            
            local blocked = isPlayerBlocked(p)
            local isPlaying = isPlayerPlayingSound(p)
            
            if blocked then
                btn.Text = " 🚫 " .. p.DisplayName
                btn.TextColor3 = THEME.BLOCKED
            elseif isPlaying then
                btn.Text = " 🔊 " .. p.DisplayName
                btn.TextColor3 = THEME.ACCENT
            else
                btn.Text = " " .. p.DisplayName
                btn.TextColor3 = THEME.TEXT_MAIN
            end
        end
    end
end

local function updatePlayerList()
    for _, btn in pairs(playerBtnItems) do btn:Destroy() end
    playerBtnItems = {}

    local list = Players:GetPlayers()
    for _, p in ipairs(list) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 26)
        btn.BackgroundColor3 = THEME.BG
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = playersScroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            for _, b in pairs(playerBtnItems) do
                b.BackgroundColor3 = THEME.BG
            end
            btn.BackgroundColor3 = Color3.fromRGB(44, 40, 25)
            if isPlayerBlocked(p) then
                statusLabel.Text = "⚠️ ผู้เล่นนี้อยู่ใน Blacklist"
            else
                statusLabel.Text = "เลือกแล้ว: " .. p.DisplayName
            end
        end)
        playerBtnItems[p] = btn
    end
    playersScroll.CanvasSize = UDim2.new(0, 0, 0, #list * 29)
    refreshList()
end

