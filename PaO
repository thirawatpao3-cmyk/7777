-- ค้นหา Sound ID โดยไม่สนใจ Tool, Accessory และเสียง SFX สั้นๆ
local function scanPlayerSounds(player)
    if not player or isPlayerBlocked(player) then return {} end
    local list, seen = {}, {}

    if player.Character then
        for _, obj in ipairs(player.Character:GetDescendants()) do
            if obj:IsA("Sound") then
                -- 1. กรองเสียงที่อยู่ใน Tool (ไอเทมถือ) หรือ Accessory (ของแต่งตัว) ออก
                local isFromItem = obj:FindFirstAncestorWhichIsA("Tool") ~= nil or obj:FindFirstAncestorWhichIsA("Accessory") ~= nil
                
                -- 2. กรองเสียง SFX สั้นๆ ออก (ดึงเฉพาะเพลงขนาดยาว หรือที่ตั้ง Loop ไว้)
                local isMusic = obj.TimeLength == 0 or obj.TimeLength > 10 or obj.Looped

                if not isFromItem and isMusic then
                    local finalId = cleanSoundId(obj.SoundId)
                    if finalId and not seen[finalId] then
                        seen[finalId] = true
                        table.insert(list, finalId)
                    end
                end
            end
        end
    end
    return list
end

