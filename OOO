----------------------------------------------------
-- LOGIC & ANIMATIONS (ระบบการทำงาน)
----------------------------------------------------
local isToggled = false -- สถานะเปิด/ปิด
local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Function: เปิด/ปิด สวิตช์ (Auto Feature)
switchBtn.MouseButton1Click:Connect(function()
	isToggled = not isToggled
	
	if isToggled then
		-- เอนิเมชันเปิด (On)
		TweenService:Create(dot, tweenInfo, {Position = UDim2.new(1, -25, 0.5, -11)}):Play()
		TweenService:Create(switchBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(46, 204, 113)}):Play() -- สีเขียว
		statusLabel.Text = "Status: ON"
		statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
		
		-- ✅ ใส่โค้ดทำงานตอน ON ตรงนี้
		print("Auto Feature: Enabled")
	else
		-- เอนิเมชันปิด (Off)
		TweenService:Create(dot, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -11)}):Play()
		TweenService:Create(switchBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}):Play() -- สีเทา
		statusLabel.Text = "Status: OFF"
		statusLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
		
		-- ❌ ใส่โค้ดทำงานตอน OFF ตรงนี้
		print("Auto Feature: Disabled")
	end
end)

-- Function: ซ่อน/แสดง หน้าต่างหลัก
