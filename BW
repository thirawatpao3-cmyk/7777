-- 4. ระบบการทำงาน (Logic System)
-----------------------------------------------------------------
local CORRECT_KEY = "pao"
local isUnlocked = false

-- ตรวจสอบคีย์
submitBtn.MouseButton1Click:Connect(function()
	if keyInput.Text == CORRECT_KEY then
		isUnlocked = true
		keyFrame.Visible = false
		mainFrame.Visible = true
	else
		keyInput.Text = ""
		keyInput.PlaceholderText = "คีย์ไม่ถูกต้อง!"
		keyInput.BackgroundColor3 = Color3.fromRGB(60, 30, 35)
		task.wait(1.2)
		keyInput.BackgroundColor3 = Color3.fromRGB(33, 36, 44)
		keyInput.PlaceholderText = "พิมพ์คีย์ที่นี่..."
	end
end)

-- ปุ่มปิด (X)
closeBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)

-- กดปุ่ม K เพื่อย่อ/เปิด
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and isUnlocked and input.KeyCode == Enum.KeyCode.K then
		mainFrame.Visible = not mainFrame.Visible
	end
end)
