local selectedPlayer = nil
local playerBtnItems = {}
local currentExtractedIDs = {}

local function scanPlayerSounds(player)
    if not player or isPlayerBlocked(player) then return {} end
    local list = {}
    local seen = {}

    local targets = {}
    if player.Character then table.insert(targets, player.Character) end
    if player:FindFirstChild("Backpack") then table.insert(targets, player.Backpack) end

    for _, container in ipairs(targets) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Sound") then
                local finalId = cleanSoundId(obj.SoundId)
                if finalId and not seen[finalId] then
                    seen[finalId] = true
                    table.insert(list, finalId)
                end
            end
        end
    end
    return list
end

local function formatPlayerStatus(p, btn)
    local blocked = isPlayerBlocked(p)
    local isPlaying = isPlayerPlayingSound(p)

    if blocked then
        btn.Text = "🚫 " .. p.DisplayName
        btn.TextColor3 = Color3.fromRGB(110, 110, 120)
    elseif isPlaying then
        btn.Text = "🔊 " .. p.DisplayName
        btn.TextColor3 = Color3.fromRGB(255, 80, 110)
    else
        btn.Text = "👤 " .. p.DisplayName
        btn.TextColor3 = Color3.fromRGB(210, 210, 220)
    end
end

local function updatePlayerList()
    for _, btn in pairs(playerBtnItems) do
        btn:Destroy()
    end
    playerBtnItems = {}

    local players = Players:GetPlayers()
    for _, p in ipairs(players) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = playersScroll

        local pCorner = Instance.new("UICorner")
        pCorner.CornerRadius = UDim.new(0, 6)
        pCorner.Parent = btn

        local pPadding = Instance.new("UIPadding")
        pPadding.PaddingLeft = UDim.new(0, 10)
        pPadding.Parent = btn

        formatPlayerStatus(p, btn)

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            for _, b in pairs(playerBtnItems) do
                b.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
            end
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)

            if isPlayerBlocked(p) then
                statusLabel.Text = "⚠️ ผู้เล่นนี้อยู่ในรายการ Blacklist"
            else
                statusLabel.Text = "● เลือกแล้ว: " .. p.DisplayName
            end
        end)

        playerBtnItems[p] = btn
    end
    playersScroll.CanvasSize = UDim2.new(0, 0, 0, #players * 35)
end

updatePlayerList()

task.spawn(function()
    while task.wait(1.5) do
        for p, btn in pairs(playerBtnItems) do
            if p and p.Parent then
                formatPlayerStatus(p, btn)
            end
        end
    end
end)

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)

-- Actions
btnHackSound.MouseButton1Click:Connect(function()
    if not selectedPlayer then
        statusLabel.Text = "กรุณาเลือกผู้เล่นจากรายการด้านซ้าย"
        return
    end

    if isPlayerBlocked(selectedPlayer) then
        statusLabel.Text = "❌ ไม่สามารถตรวจสอบได้ (Blacklist)"
        return
    end

    currentExtractedIDs = scanPlayerSounds(selectedPlayer)
    if #currentExtractedIDs > 0 then
        local textToCopy = table.concat(currentExtractedIDs, "\n")
        idDisplayLabel.Text = textToCopy
        idScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#currentExtractedIDs * 20, 150))

        local copied = copyToClipboard(textToCopy)
        if copied then
            statusLabel.Text = "✅ คัดลอก " .. #currentExtractedIDs .. " ID ลง Clipboard แล้ว"
        else
            statusLabel.Text = "พบ " .. #currentExtractedIDs .. " รายการ"
        end
    else
        currentExtractedIDs = {}
        idDisplayLabel.Text = ""
        statusLabel.Text = "ไม่พบ Audio ID ที่เล่นอยู่"
    end
end)

