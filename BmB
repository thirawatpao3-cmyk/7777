-- ฟังก์ชันค้นหาผู้เล่น
local function getPlayerByName(query)
    query = query:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #query) == query or p.DisplayName:lower():sub(1, #query) == query then
            return p
        end
    end
    return nil
end

-- การทำงานเมื่อกดปุ่มสแกน
scanBtn.MouseButton1Click:Connect(function()
    local targetText = searchBox.Text
    if targetText == "" then
        resultText.Text = "กรุณากรอกชื่อผู้เล่น"
        return
    end

    local target = getPlayerByName(targetText)
    if not target then
        resultText.Text = "ไม่พบผู้เล่น: " .. targetText
        return
    end

    local output = string.format("User: %s\nID: %d\nDisplay: %s\n\n[Sounds Found]\n", target.Name, target.UserId, target.DisplayName)
    local char = target.Character

    if not char then
        resultText.Text = output .. "(ผู้เล่นยังไม่มีตัวละครในเกม)"
        return
    end

    local foundCount = 0
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Sound") then
            foundCount = foundCount + 1
            local realId = extractRealId(item.SoundId) or item.SoundId:match("%d+") or "N/A"
            output = output .. string.format("• %s\n  ID: %s\n", item.Name, realId)
        end
    end

    if foundCount == 0 then
        output = output .. "ไม่พบ Sound ใดๆ ในตัวละคร"
    end

    resultText.Text = output
end)
