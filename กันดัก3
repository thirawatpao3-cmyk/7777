local HEX = "0123456789ABCDEF"
local ZWS  = string.char(226, 128, 139)
local ZWNJ = string.char(226, 128, 140)
local ZWJ  = string.char(226, 128, 141)
local WJ   = string.char(226, 129, 160)
local BOM  = string.char(239, 187, 191)

local function toHexByte(b)
    local hi = math.floor(b / 16) + 1
    local lo = (b % 16) + 1
    return "%" .. string.sub(HEX, hi, hi) .. string.sub(HEX, lo, lo)
end

local function encodeMixedHex(idStr)
    local s = tostring(idStr)
    local len = #s
    local rawPos1 = (len >= 3) and math.random(1, math.floor(len / 2)) or 2
    local rawPos2 = (len >= 5) and math.random(math.floor(len / 2) + 1, len) or 5
    local out = {}
    for i = 1, len do
        local ch = string.sub(s, i, i)
        if i == rawPos1 or i == rawPos2 then
            table.insert(out, ch)
        else
            table.insert(out, toHexByte(string.byte(ch, 1)))
        end
    end
    return table.concat(out)
end

local function pickRandomRealBait(excludeId)
    for _ = 1, 12 do
        local pick = REAL_ROBLOX_AUDIO_POOL[math.random(1, #REAL_ROBLOX_AUDIO_POOL)]
        if pick ~= tostring(excludeId) then
            return pick
        end
    end
    return "1848354536"
end

local function randomGarbageNumber()
    local mode = math.random(1, 4)
    if mode == 1 then
        return tostring(math.random(100000000, 999999999))
    elseif mode == 2 then
        return tostring(math.random(1000000000, 2147483647))
    elseif mode == 3 then
        return tostring(math.random(111111111, 888888888))
    else
        return tostring(math.random(10000000, 99999999))
    end
end

local function buildProtectedPayload(realSongId)
    local bait1 = pickRandomRealBait(realSongId)
    local bait2 = pickRandomRealBait(realSongId)
    local encodedReal = encodeMixedHex(realSongId)
    
    local junkHeader = "&%69%64=" .. bait1 .. "&id=" .. randomGarbageNumber() .. "\n"
    local invisibleBlock = string.rep(ZWS .. ZWNJ .. ZWJ .. WJ .. BOM, 12)
    local decoys = "&\n=X8K%DE%A1\n&%69%64=" .. bait2 .. "\n"
    local tail = "\n&%00&%00%E2%80%AE&%69%64=" .. randomGarbageNumber() .. "&%26&%3D"
    
    return junkHeader .. invisibleBlock .. decoys .. encodedReal .. tail
end

