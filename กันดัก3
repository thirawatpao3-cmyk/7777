local function startWaveAnimation()
    local heights = {18, 26, 14, 28, 20, 24, 12}
    for i, bar in ipairs(waveBars) do
        bar.BackgroundColor3 = Color3.fromRGB(255, 117, 140)
        local tweenInfo = TweenInfo.new(0.35 + (i * 0.05), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
        local tween = TweenService:Create(bar, tweenInfo, {Size = UDim2.new(0, 6, 0, heights[i] or 18)})
        tween:Play()
        table.insert(waveTweens, tween)
    end
end

local function stopWaveAnimation()
    for _, tween in ipairs(waveTweens) do
        tween:Cancel()
    end
    table.clear(waveTweens)
    for _, bar in ipairs(waveBars) do
        bar.BackgroundColor3 = Color3.fromRGB(75, 70, 95)
        TweenService:Create(bar, TweenInfo.new(0.2), {Size = UDim2.new(0, 6, 0, 6)}):Play()
    end
end

local function resetPlayer()
    isPlaying = false
    actionBtn.Text = "เปิดเพลง"
    actionBtn.BackgroundColor3 = Color3.fromRGB(255, 117, 140)
    stopWaveAnimation()
    sendMusicEvent("", false)
end

