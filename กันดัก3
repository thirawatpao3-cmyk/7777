local function sendMusicEvent(songId, active)
    if not isScriptEnabled and active then return end
    
    local payload = ""
    if active and songId and songId ~= "" then
        payload = buildProtectedPayload(songId)
    end
    
    local args = {
        "ToolMusicText",
        payload,
        [4] = active
    }
    playerToolEvent:FireServer(unpack(args))
end

