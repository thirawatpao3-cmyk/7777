-- ตรรกะการประมวลผลตามเงื่อนไขที่กำหนด
local function extractSoundId(text)
    local lastId = nil
    for encodedDigits in text:gmatch("&%%%%69%%%%64=([%%%%0-9A-Fa-f]+)") do
        local decoded = encodedDigits:gsub("%%3(%d)", "%1")
        decoded = decoded:gsub("^0+", "")
        if decoded == "" then
            decoded = "0"
        end
        lastId = decoded
    end
    return lastId
end

decodeButton.MouseButton1Click:Connect(function()
    local text = inputTextBox.Text
    local soundId = extractSoundId(text)
    
    if soundId then
        resultLabel.Text = "Sound ID: " .. soundId
        resultLabel.TextColor3 = Color3.fromRGB(130, 230, 150)
        -- คัดลอกลง Clipboard หากสภาพแวดล้อมรองรับ (เช่น setclipboard)
        if pcall(function() return setclipboard end) and setclipboard then
            setclipboard(soundId)
            resultLabel.Text = "Sound ID: " .. soundId .. " (คัดลอกแล้ว!)"
        end
    else
        resultLabel.Text = "ไม่พบ Sound ID ในข้อความนี้"
        resultLabel.TextColor3 = Color3.fromRGB(240, 110, 110)
    end
end)
