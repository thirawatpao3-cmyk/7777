--- ฟังก์ชันอัปเดตรายชื่อผู้เล่นใน Dropdown ---
local function refreshPlayerList()
    for _, item in ipairs(listFrame:GetChildren()) do
        if item:IsA("TextButton") then
            item:Destroy()
        end
    end

    local currentPlayers = Players:GetPlayers()
    for _, plr in ipairs(currentPlayers) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, 0, 0, 28)
        pBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        pBtn.Font = Enum.Font.SourceSans
        pBtn.TextSize = 13
        pBtn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
        pBtn.BorderSizePixel = 0
        pBtn.Parent = listFrame

        pBtn.MouseButton1Click:Connect(function()
            selectedPlayer = plr
            dropdownBtn.Text = "เลือก: " .. plr.DisplayName
            listFrame.Visible = false
        end)
    end
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #currentPlayers * 30)
end

-- สลับการแสดงผล Dropdown
dropdownBtn.MouseButton1Click:Connect(function()
    listFrame.Visible = not listFrame.Visible
    if listFrame.Visible then
        refreshPlayerList()
    end
end)

