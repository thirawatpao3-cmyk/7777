	end
	IntervalInput.Text = "ระยะเวลา/วินาที: " .. interval
end)

-- [3] ปุ่มส่งตามจำนวนครั้ง (Button)
local RunButton = Instance.new("TextButton")
RunButton.Size = UDim2.new(0.9, 0, 0, 38)
RunButton.Position = UDim2.new(0.05, 0, 0.45, 0)
RunButton.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
RunButton.Text = "เรียกตามจำนวนครั้ง"
RunButton.TextColor3 = Color3.fromRGB(255, 255, 255)
RunButton.TextSize = 13
RunButton.Font = Enum.Font.GothamBold
RunButton.Parent = Frame

local RC = Instance.new("UICorner")
RC.CornerRadius = UDim.new(0, 8)
RC.Parent = RunButton

RunButton.MouseButton1Click:Connect(function()
	task.spawn(function()
		for i = 1, times do
			local args = { "SkateBoard" }
			game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1NoMoto1rVehicle1s"):FireServer(unpack(args))
			task.wait(interval)
		end
	end)
end)

-- [4] ปุ่ม Toggle เปิด/ปิด การวนลูป (Toggle Button)
local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0.9, 0, 0, 38)
ToggleButton.Position = UDim2.new(0.05, 0, 0.60, 0)
ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleButton.Text = "Auto Loop: ปิด"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 13
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Parent = Frame

local TGC = Instance.new("UICorner")
TGC.CornerRadius = UDim.new(0, 8)
TGC.Parent = ToggleButton

ToggleButton.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	
	if isRunning then
		ToggleButton.Text = "Auto Loop: เปิดอยู่"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		
		task.spawn(function()
			while isRunning do
				local args = { "SkateBoard" }
				game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1NoMoto1rVehicle1s"):FireServer(unpack(args))
				task.wait(interval)
			end
		end)
	else
		ToggleButton.Text = "Auto Loop: ปิด"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end)

