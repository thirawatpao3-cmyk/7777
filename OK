IntervalInput.Text = "ระยะเวลา/วินาที: 0.5"
IntervalInput.TextColor3 = Color3.fromRGB(220, 220, 220)
IntervalInput.TextSize = 13
IntervalInput.Font = Enum.Font.Gotham
IntervalInput.Parent = Frame

local IC = Instance.new("UICorner")
IC.CornerRadius = UDim.new(0, 8)
IC.Parent = IntervalInput

IntervalInput.FocusLost:Connect(function()
	local val = tonumber(IntervalInput.Text:match("[%d%.]+"))
	if val then
