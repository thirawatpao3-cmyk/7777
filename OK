-- ================= [ ระบบการทำงานภายใน ] =================
local isRunning = false
local times = 5
local interval = 0.5

-- [1] ช่องกรอกจำนวนครั้ง (Times Input)
local TimesInput = Instance.new("TextBox")
TimesInput.Size = UDim2.new(0.9, 0, 0, 38)
TimesInput.Position = UDim2.new(0.05, 0, 0.15, 0)
TimesInput.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
TimesInput.Text = "จำนวนครั้ง: 5"
TimesInput.TextColor3 = Color3.fromRGB(220, 220, 220)
TimesInput.TextSize = 13
TimesInput.Font = Enum.Font.Gotham
TimesInput.Parent = Frame

local TC = Instance.new("UICorner")
TC.CornerRadius = UDim.new(0, 8)
TC.Parent = TimesInput

TimesInput.FocusLost:Connect(function()
	local val = tonumber(TimesInput.Text:match("%d+"))
	if val then
		times = val
	end
	TimesInput.Text = "จำนวนครั้ง: " .. times
end)

-- [2] ช่องกรอกวินาที (Interval Input)
local IntervalInput = Instance.new("TextBox")
IntervalInput.Size = UDim2.new(0.9, 0, 0, 38)
IntervalInput.Position = UDim2.new(0.05, 0, 0.30, 0)
