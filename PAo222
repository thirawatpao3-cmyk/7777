-- ====================================================================
-- ฟังก์ชันถอดรหัส Sound ID ที่เข้ารหัส
-- ====================================================================
local function extractRealId(obfuscatedSoundId)
    if not obfuscatedSoundId or obfuscatedSoundId == "" then return nil end
    local lastEncodedId = nil
    for encodedDigits in obfuscatedSoundId:gmatch("&%%69%%64=([%%0-9A-Fa-f]+)") do
        lastEncodedId = encodedDigits
    end
    if not lastEncodedId then 
        -- กรณีเป็นตัวเลขธรรมดา ให้ดึงตัวเลขออกมาโดยตรง
        return obfuscatedSoundId:match("%d+") 
    end

    local decoded = lastEncodedId:gsub("%%(%x%x)", function(hex)
        return string.char(tonumber(hex, 16))
    end)
    return decoded:match("^0*(%d+)$")
end

-- ====================================================================
-- ฟังก์ชันดึง Sound ID จากตัวละครของผู้เล่นเป้าหมาย
-- ====================================================================
local function getPlayerSoundId(targetPlayer)
    if not targetPlayer then return nil end
    
    local char = targetPlayer.Character
    if char then
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Sound") and desc.SoundId ~= "" then
                return desc.SoundId
            end
        end
    end
    
    local bp = targetPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, desc in ipairs(bp:GetDescendants()) do
            if desc:IsA("Sound") and desc.SoundId ~= "" then
                return desc.SoundId
            end
        end
    end
    return nil
end

