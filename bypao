-- กลไกย่อ / ขยายหน้าต่าง (Minimize Logic)
local isMinimized = false
local fullSize = UDim2.new(0, 420, 0, 360)
local minSize = UDim2.new(0, 420, 0, 45)

minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    
    if isMinimized then
        contentContainer.Visible = false
        minBtn.Text = "+"
        TweenService:Create(mainFrame, tweenInfo, {Size = minSize}):Play()
    else
        minBtn.Text = "−"
        local tween = TweenService:Create(mainFrame, tweenInfo, {Size = fullSize})
        tween:Play()
        tween.Completed:Connect(function()
            if not isMinimized then
                contentContainer.Visible = true
            end
        end)
    end
end)

-- ฟังก์ชันถอดรหัส Sound ID
local function extractSoundId(text)
    local lastId = nil
    for encodedDigits in text:gmatch("&%%%%69%%%%64=([%%%%0-9A-Fa-f]+)") do
        local decoded = encodedDigits:gsub("%%3(%d)", "%1")
        decoded = decoded:gsub("^0+", "")
        if decoded == "" then
            decoded = "0"
        end
        lastId = decoded
    end
    return lastId
end

-- ฟังก์ชันตรวจจับเสียงที่กำลังเล่น
local function getPlayingSounds(plr)
    local sounds = {}
    if plr.Character then
        for _, obj in ipairs(plr.Character:GetDescendants()) do
            if obj:IsA("Sound") and (obj.IsPlaying or obj.TimePosition > 0) then
                table.insert(sounds, obj)
            end
        end
    end
    return sounds
end

-- อัปเดตรายชื่อผู้เล่น
local function updatePlayerList()
    for _, child in ipairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        local sounds = getPlayingSounds(plr)
        if #sounds > 0 then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 32)
            btn.BackgroundColor3 = Color3.fromRGB(38, 42, 54)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = "🔊 " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
            btn.TextSize = 12
            btn.Font = Enum.Font.Gotham
            btn.Parent = playerListFrame

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 6)
            bCorner.Parent = btn

            btn.MouseButton1Click:Connect(function()
                local rawSound = sounds[1]
                local rawId = rawSound and rawSound.SoundId or ""
                local decodedId = extractSoundId(rawId)

                if decodedId then
                    resultLabel.Text = "ผู้เล่น: " .. plr.Name .. "\nSound ID (ถอดรหัส): " .. decodedId
                    resultLabel.TextColor3 = Color3.fromRGB(140, 220, 160)
                    if pcall(function() return setclipboard end) and setclipboard then
                        setclipboard(decodedId)
                        resultLabel.Text = resultLabel.Text .. " (คัดลอกลงคลิปบอร์ดแล้ว!)"
                    end
                else
                    resultLabel.Text = "ผู้เล่น: " .. plr.Name .. "\nRaw ID: " .. rawId .. "\n(ไม่พบรหัสที่เข้ารหัสไว้)"
                    resultLabel.TextColor3 = Color3.fromRGB(240, 140, 140)
                end
            end)
        end
    end

    if count == 0 and resultLabel.Text:find("Sound ID") == nil then
        resultLabel.Text = "กำลังรอผู้เล่นเปิดเพลง..."
        resultLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
    end
end

