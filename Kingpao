-- 4. การทำงาน (Logic & ตรวจจับเสียงแบบสีแดง)
-----------------------------------------------------------
local selectedPlayer = nil

local function scanPlayerSounds(player)
    if not player then return end

    local text = string.format("User ID:\n%d\n\nSound ID:\n", player.UserId)
    local char = player.Character

    if not char then
        resultText.Text = text .. "(ไม่พบโมเดลตัวละคร)"
        return
    end

    local count = 0
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Sound") then
            count = count + 1
            local realId = extractRealId(item.SoundId) or item.SoundId:match("%d+")
            if realId then
                text = text .. realId .. "\n"
            end
        end
    end

    if count == 0 then
        text = text .. "(ไม่พบ Sound)"
    end

    resultText.Text = text

    -- อัปเดตสีของปุ่มเลือกหลักตามสถานะเสียง
    if isPlayerPlayingSound(player) then
        selectBtn.TextColor3 = Color3.fromRGB(255, 75, 75) -- สีแดงเมื่อมีเสียง
    else
        selectBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end

-- ฟังก์ชันสร้างและอัปเดตรายชื่อใน Dropdown
local function updatePlayerList()
    for _, child in ipairs(dropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        local isPlaying = isPlayerPlayingSound(p)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 26)
        btn.BackgroundColor3 = Color3.fromRGB(36, 36, 46)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.ZIndex = 11
        btn.Parent = dropdownList

        -- ถ้านักเตะเปิดเสียงอยู่ ให้ตั้งชื่อเป็นสีแดง พร้อมไอคอนลำโพง
        if isPlaying then
            btn.Text = "🔊 " .. p.DisplayName
            btn.TextColor3 = Color3.fromRGB(255, 70, 70) -- สีแดง
        else
            btn.Text = p.DisplayName
            btn.TextColor3 = Color3.fromRGB(220, 220, 220) -- สีปกติ
        end

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            selectBtn.Text = p.DisplayName .. " ▼"
            dropdownList.Visible = false
            scanPlayerSounds(p)
        end)
    end
    dropdownList.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 28)
end

selectBtn.MouseButton1Click:Connect(function()
    if not dropdownList.Visible then
        updatePlayerList()
        dropdownList.Visible = true
    else
        dropdownList.Visible = false
    end
end)

scanBtn.MouseButton1Click:Connect(function()
    if selectedPlayer then
        scanPlayerSounds(selectedPlayer)
    else
        resultText.Text = "กรุณาเลือกผู้เล่นก่อน"
    end
end)

