-- 4. การทำงาน (Logic)
-----------------------------------------------------------
local selectedPlayer = nil
local playerButtons = {}

local function scanPlayerSounds(player)
    if not player then return end

    local text = string.format("User ID:\n%d\n\nSound ID:\n", player.UserId)
    local char = player.Character

    if not char then
        resultText.Text = text .. "(ไม่พบโมเดล)"
        return
    end

    local count = 0
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Sound") then
            local finalId = cleanSoundId(item.SoundId)
            if finalId and finalId ~= "" then
                count = count + 1
                text = text .. finalId .. "\n"
            end
        end
    end

    if count == 0 then
        text = text .. "(ไม่พบ Sound)"
    end

    resultText.Text = text
end

-- สร้างปุ่มชื่อผู้เล่นทั้งหมดวางเรียงไว้เลย
local function buildPlayerButtons()
    -- ล้างปุ่มเดิม
    for _, btn in pairs(playerButtons) do
        btn:Destroy()
    end
    playerButtons = {}

    local players = Players:GetPlayers()
    for _, p in ipairs(players) do
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextTruncate = Enum.TextTruncate.AtEnd
        btn.Parent = playersGrid

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 5)
        bCorner.Parent = btn

        local bStroke = Instance.new("UIStroke")
        bStroke.Color = Color3.fromRGB(50, 50, 65)
        bStroke.Thickness = 1
        bStroke.Parent = btn

        -- ตรวจสอบว่ามีเสียงไหมเพื่อใส่สีแดง
        if isPlayerPlayingSound(p) then
            btn.Text = "🔊 " .. p.DisplayName
            btn.TextColor3 = Color3.fromRGB(255, 75, 75) -- สีแดงเมื่อมีเสียง
            bStroke.Color = Color3.fromRGB(150, 40, 40)
        else
            btn.Text = p.DisplayName
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        end

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            scanPlayerSounds(p)
        end)

        playerButtons[p] = btn
    end

    -- คำนวณความสูง Canvas เพื่อให้รองรับกรณีคนเยอะมาก
    local rows = math.ceil(#players / 3)
    playersGrid.CanvasSize = UDim2.new(0, 0, 0, rows * 33 + 10)
end

-- สร้างปุ่มครั้งแรก
buildPlayerButtons()

-- ตรวจจับเสียงแบบ Real-time (อัปเดตสีแดงของปุ่มอัตโนมัติทุก 1 วินาที)
task.spawn(function()
    while task.wait(1) do
        for p, btn in pairs(playerButtons) do
            if p and p.Parent then
                if isPlayerPlayingSound(p) then
                    btn.Text = "🔊 " .. p.DisplayName
                    btn.TextColor3 = Color3.fromRGB(255, 75, 75)
                else
                    btn.Text = p.DisplayName
                    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                end
            end
        end
    end
end)

