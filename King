-- 4. การทำงาน (Logic)
-----------------------------------------------------------
local selectedPlayer = nil

-- ฟังก์ชันสแกนหาเสียงของผู้เล่น
local function scanPlayerSounds(player)
    if not player then return end

    local text = string.format("ผู้เล่น: %s\nไอดี (UserId): %d\nDisplay: %s\n\n[รายการ Sound ID]\n", player.Name, player.UserId, player.DisplayName)
    local char = player.Character

    if not char then
        resultText.Text = text .. "(ไม่พบโมเดลตัวละครในเกมขณะนี้)"
        return
    end

    local count = 0
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Sound") then
            count = count + 1
            local realId = extractRealId(item.SoundId) or item.SoundId:match("%d+") or "N/A"
            text = text .. string.format("• %s\n  Asset ID: %s\n", item.Name, realId)
        end
    end

    if count == 0 then
        text = text .. "ไม่พบ Sound ใดๆ ในตัวละครนี้"
    end

    resultText.Text = text
end

-- อัปเดตรายชื่อผู้เล่นใน Dropdown
local function updatePlayerList()
    for _, child in ipairs(dropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
        btn.BorderSizePixel = 0
        btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.ZIndex = 6
        btn.Parent = dropdownList

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            selectBtn.Text = p.DisplayName .. " ▼"
            dropdownList.Visible = false
            scanPlayerSounds(p)
        end)
    end
    dropdownList.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 32)
end

-- คลิกปุ่ม Dropdown
selectBtn.MouseButton1Click:Connect(function()
    if not dropdownList.Visible then
        updatePlayerList()
        dropdownList.Visible = true
    else
        dropdownList.Visible = false
    end
end)

-- คลิกรีเฟรช
scanBtn.MouseButton1Click:Connect(function()
