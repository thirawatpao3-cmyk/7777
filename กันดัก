-- ฟังก์ชันแอนิเมชันคลื่น
local function startWaveAnimation()
    local heights = {18, 26, 14, 28, 20, 24, 12}
    for i, bar in ipairs(waveBars) do
        bar.BackgroundColor3 = Color3.fromRGB(255, 117, 140)
        local tweenInfo = TweenInfo.new(0.35 + (i * 0.05), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
        local tween = TweenService:Create(bar, tweenInfo, {Size = UDim2.new(0, 6, 0, heights[i] or 18)})
        tween:Play()
        table.insert(waveTweens, tween)
    end
end

local function stopWaveAnimation()
    for _, tween in ipairs(waveTweens) do
        tween:Cancel()
    end
    table.clear(waveTweens)
    for _, bar in ipairs(waveBars) do
        bar.BackgroundColor3 = Color3.fromRGB(75, 70, 95)
        TweenService:Create(bar, TweenInfo.new(0.2), {Size = UDim2.new(0, 6, 0, 6)}):Play()
    end
end

local function resetPlayer()
    isPlaying = false
    actionBtn.Text = "เปิดเพลง"
    actionBtn.BackgroundColor3 = Color3.fromRGB(255, 117, 140)
    stopWaveAnimation()
    sendMusicEvent("", false)
end

-- สลับเปิด/ปิดสคริปต์
toggleBtn.MouseButton1Click:Connect(function()
    isScriptEnabled = not isScriptEnabled
    
    local targetCirclePos = isScriptEnabled and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    local targetBgColor = isScriptEnabled and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(75, 70, 90)
    
    TweenService:Create(toggleCircle, TweenInfo.new(0.2), {Position = targetCirclePos}):Play()
    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = targetBgColor}):Play()
    
    if isScriptEnabled then
        statusLabel.Text = "สถานะ: เปิดใช้งานสคริปต์แล้ว"
        statusLabel.TextColor3 = Color3.fromRGB(46, 213, 115)
    else
        resetPlayer()
        statusLabel.Text = "สถานะ: ปิดการทำงานสคริปต์"
        statusLabel.TextColor3 = Color3.fromRGB(255, 71, 87)
    end
end)

-- กดปุ่ม เปิด/ปิด เพลง
actionBtn.MouseButton1Click:Connect(function()
    if not isScriptEnabled then
        statusLabel.Text = "กรุณาเปิดสวิตช์สคริปต์ก่อนใช้งาน"
        statusLabel.TextColor3 = Color3.fromRGB(255, 71, 87)
        return
    end

    if not isPlaying then
        local rawText = idInput.Text
        local songId = rawText:match("%d+")
        if songId and songId ~= "" then
            isPlaying = true
            actionBtn.Text = "ปิดเพลง"
            actionBtn.BackgroundColor3 = Color3.fromRGB(235, 77, 75)
            statusLabel.Text = "กำลังเล่น: ID " .. songId
            statusLabel.TextColor3 = Color3.fromRGB(46, 213, 115)
            
            startWaveAnimation()
            sendMusicEvent(songId, true)
        else
            statusLabel.Text = "กรุณาใส่ ID ให้ถูกต้อง"
            statusLabel.TextColor3 = Color3.fromRGB(255, 71, 87)
        end
    else
        resetPlayer()
        statusLabel.Text = "สถานะ: ปิดเพลงแล้ว"
        statusLabel.TextColor3 = Color3.fromRGB(130, 125, 150)
    end
end)
