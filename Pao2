-- ฟังก์ชันคัดลอกข้อความลง Clipboard
local function copyToClipboard(text)
    local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
    if fn then
        fn(tostring(text))
        return true
    end
    return false
end

-- ฟังก์ชันถอดรหัส Sound ID และตัดเลข 3 ด้านหน้าออก
local function extractRealId(obfuscatedSoundId)
    if not obfuscatedSoundId or type(obfuscatedSoundId) ~= "string" then return nil end
    local lastEncodedId = nil
    for encodedDigits in obfuscatedSoundId:gmatch("&%%69%%64=([%%0-9A-Fa-f]+)") do
        lastEncodedId = encodedDigits
    end
    if not lastEncodedId then return nil end

    local decoded = lastEncodedId:gsub("%%(%x%x)", function(hex)
        return string.char(tonumber(hex, 16))
    end)
    local rawId = decoded:match("^0*(%d+)$")
    if rawId then
        if rawId:sub(1, 1) == "3" then
            rawId = rawId:sub(2)
        end
        return rawId
    end
    return nil
end

-- ดึงเฉพาะตัวเลขล้วนเท่านั้น
local function cleanSoundId(soundId)
    local id = extractRealId(soundId) or tostring(soundId):match("%d+")
    if id and id:sub(1, 1) == "3" then
        id = id:sub(2)
    end
    -- ตรวจสอบให้แน่ใจว่าเป็นตัวเลขล้วน
    if id and id:match("^%d+$") then
        return id
    end
    return nil
end

-- เช็คว่าผู้เล่นกำลังเปิดเสียงอยู่หรือไม่
local function isPlayerPlayingSound(player)
    if not player or not player.Character then return false end
    for _, item in ipairs(player.Character:GetDescendants()) do
        if item:IsA("Sound") and item.IsPlaying then
            return true
        end
    end
    return false
end

