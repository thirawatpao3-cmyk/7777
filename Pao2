    local textToCopy = table.concat(currentExtractedIDs, "\n")
    local success = copyToClipboard(textToCopy)

    if success then
        copyIdBtn.Text = "✅ คัดลอกสำเร็จ!"
    else
        copyIdBtn.Text = "⚠️ Executor ไม่รองรับ Clipboard"
