local selectedPlayer = nil
local playerBtnItems = {}
local currentExtractedIDs = {}

-- ฟังก์ชันค้นหา Sound ID (เฉพาะตัวเลขแท้ ไม่ซ้ำ)
local function scanPlayerSounds(player)
    if not player then return {} end
    local list = {}
    local seen = {}
    local char = player.Character
    if not char then return list end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Sound") then
            local finalId = cleanSoundId(obj.SoundId)
            if finalId and not seen[finalId] then
                seen[finalId] = true
                table.insert(list, finalId)
            end
        end
    end
    return list
end

local function updatePlayerList()
    for _, btn in pairs(playerBtnItems) do
        btn:Destroy()
    end
    playerBtnItems = {}

    local players = Players:GetPlayers()
    for _, p in ipairs(players) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(26, 16, 16)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = playersScroll

        local pCorner = Instance.new("UICorner")
        pCorner.CornerRadius = UDim.new(0, 6)
        pCorner.Parent = btn

        local pPadding = Instance.new("UIPadding")
        pPadding.PaddingLeft = UDim.new(0, 8)
        pPadding.Parent = btn

        local isPlaying = isPlayerPlayingSound(p)
        if isPlaying then
            btn.Text = "🔊 " .. p.DisplayName .. " (@" .. p.Name .. ")"
            btn.TextColor3 = Color3.fromRGB(255, 70, 70)
        else
            btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            btn.TextColor3 = Color3.fromRGB(210, 200, 200)
        end

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            for _, b in pairs(playerBtnItems) do
                b.BackgroundColor3 = Color3.fromRGB(26, 16, 16)
            end
            btn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            statusLabel.Text = "เลือกแล้ว: " .. p.DisplayName
        end)

        playerBtnItems[p] = btn
    end
    playersScroll.CanvasSize = UDim2.new(0, 0, 0, #players * 32)
end

updatePlayerList()

task.spawn(function()
    while task.wait(1) do
        for p, btn in pairs(playerBtnItems) do
            if p and p.Parent then
                if isPlayerPlayingSound(p) then
                    btn.Text = "🔊 " .. p.DisplayName .. " (@" .. p.Name .. ")"
                    btn.TextColor3 = Color3.fromRGB(255, 70, 70)
                else
                    btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                    btn.TextColor3 = Color3.fromRGB(210, 200, 200)
                end
            end
        end
    end
end)

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)

-- ปุ่มเจาะไอดีเพลง
btnHackSound.MouseButton1Click:Connect(function()
    if not selectedPlayer then
        statusLabel.Text = "กรุณาเลือกผู้เล่นทางด้านซ้ายก่อน!"
        return
    end

    currentExtractedIDs = scanPlayerSounds(selectedPlayer)
    if #currentExtractedIDs > 0 then
        local textToCopy = table.concat(currentExtractedIDs, "\n")
        idDisplayLabel.Text = textToCopy
        idScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#currentExtractedIDs * 20, 150))

        local copied = copyToClipboard(textToCopy)
        if copied then
            statusLabel.Text = "✅ เจาะและคัดลอก " .. #currentExtractedIDs .. " ID แล้ว!"
        else
            statusLabel.Text = "พบ " .. #currentExtractedIDs .. " ID (Clipboard ไม่ทำงาน)"
        end
    else
        currentExtractedIDs = {}
        idDisplayLabel.Text = ""
        idScroll.CanvasSize = UDim2.new(0, 0, 0, 150)
        statusLabel.Text = "ไม่พบ Sound ID ในตัวละครนี้"
    end
end)

